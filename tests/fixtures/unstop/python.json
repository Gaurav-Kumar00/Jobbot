    "id": 1760751,
    "public_url": "jobs/full-stack-developer-phppython-reactjs-zealous-healthcare-services-1760751",
    "title": "Full Stack Developer – PHP/Python & React.js",
    "organization_id": 1499306,
    "type": "jobs",
    "subtype": "jobs",
    "regn_open": 1,
    "updated_at": "2026-10-03T18:29:06+05:30",
    "region": "online",
    "visibility": "public",
    "details": "<p><strong>Zealous Healthcare Services is hiring for Full Stack Developer &ndash; PHP/Python &amp; React.js</strong></p>\n<p><strong>Responsibilities</strong></p>\n<ul>\n<li>Develop and maintain web applications using Core PHP, Laravel, Python, Django, Django REST Framework, and/or FastAPI.</li>\n<li>Build scalable RESTful APIs, microservices, backend services, and secure REST/JSON integrations.</li>\n<li>Create responsive and reusable interfaces using React.js, JavaScript ES6+, HTML5, CSS3, jQuery, AJAX, Bootstrap 5, React Hooks, and state-management approaches.</li>\n<li>Design and optimize MySQL and/or PostgreSQL databases, queries, scheduled jobs, background workers, and workflow automation.</li>\n<li>Implement authentication, authorization, RBAC, third-party API integrations, testing, debugging, performance improvements, and application security practices.</li>\n<li>Deploy and maintain solutions on Linux and cloud platforms such as AWS or DigitalOcean.</li>\n<li>Use Git, participate in code reviews, follow Agile practices, and collaborate with cross-functional teams on technical solutions.</li>\n</ul>\n<p><strong>Requirements</strong></p>\n<ul>\n<li>1&ndash;4 years of professional Full Stack Development experience.</li>\n<li>Bachelor&rsquo;s degree in Computer Science, Information Technology, or a related field.</li>\n<li>Strong hands-on experience in PHP/Laravel or Python/Django/FastAPI, along with React.js.</li>\n<li>Working knowledge of REST APIs, JSON, database design, query optimization, debugging, and performance-focused development.</li>\n<li>Experience with Linux environments, Git, cron jobs, background tasks, and version control workflows.</li>\n<li>Exposure to Redux or Context API, JWT/OAuth, Celery, Redis, Docker, CI/CD, microservices, AWS/DigitalOcean, CRM dashboards, reporting, automation, or AI/ML integrations will be an advantage.</li>\n<li>Willingness to work rotational shifts and communicate effectively with technical and cross-functional stakeholders.</li>\n</ul>",

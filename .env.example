# Copy to .env for local runs. In production these live in GitHub Secrets / Vercel env.
# Never commit real values.

# --- Telegram (Phase 1) ---
# Token from @BotFather, e.g. 123456789:AA...
TELEGRAM_BOT_TOKEN=
# Your personal chat id (run `uv run jobbot chat-id` after messaging your bot)
TELEGRAM_CHAT_ID=

# --- MongoDB Atlas (Phase 2) ---
MONGODB_URI=
MONGODB_DB=jobbot

# --- Optional job aggregators (Phase 9) ---
# https://developer.adzuna.com  (free: 250 calls/day, 2500/month)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# https://serpapi.com  (free: 250 searches/month) -> Google Jobs
SERPAPI_KEY=

# --- Runtime ---
JOBBOT_ENV=dev
LOG_LEVEL=INFO
